{
  "name": "@filoz/indexer-ponder",
  "version": "0.0.0",
  "private": true,
  "description": "Ponder indexer for Filecoin inventory",
  "type": "module",
  "scripts": {
    "start": "ponder start",
    "dev:calibnet": "PONDER_NETWORK=calibnet ponder dev",
    "dev:mainnet": "PONDER_NETWORK=mainnet ponder dev",
    "start:calibnet": "PONDER_NETWORK=calibnet ponder start",
    "start:mainnet": "PONDER_NETWORK=mainnet ponder start",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "clean": "rm -rf dist .ponder .turbo"
  },
  "dependencies": {
    "@filoz/indexer": "workspace:*",
    "hono": "^4.12.18",
    "@filoz/synapse-core": "catalog:",
    "ponder": "npm:@rvagg/ponder@^0.16.6",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "drizzle-orm": "catalog:",
    "typescript": "catalog:"
  }
}
