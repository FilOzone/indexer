{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev:mainnet": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL", "RPC_URL", "PONDER_STRICT_ENV"]
    },
    "dev:calibnet": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL", "RPC_URL", "PONDER_STRICT_ENV"]
    },
    "start:mainnet": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL", "RPC_URL", "PONDER_STRICT_ENV"]
    },
    "start:calibnet": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL", "RPC_URL", "PONDER_STRICT_ENV"]
    }
  }
}
